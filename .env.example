# Contact form on the portfolio (/api/contact). Set these in Vercel:
# Project Settings > Environment Variables. Never commit real values.

# Required: API key from https://resend.com
RESEND_API_KEY=

# Optional: inbox that receives messages (defaults to immanuelsavio@gmail.com)
CONTACT_TO=

# Optional: verified sender on a domain you own in Resend, e.g.
# "Portfolio <hello@immanuelsavio.com>". Without it, Resend's test sender is
# used, which only delivers to the Resend account owner's email.
CONTACT_FROM=
